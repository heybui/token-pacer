<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>Token Pacer</string>
	<key>CFBundleDisplayName</key><string>Token Pacer</string>
	<key>CFBundleExecutable</key><string>TokenPacer</string>
	<key>CFBundleIdentifier</key><string>com.redevify.token-pacer</string>
	<!-- The language every key in Localizable.xcstrings is written in, and the
	     one the app falls back to. Also what makes the bundle's localization
	     list non-empty before a second .lproj exists. -->
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.4.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSMinimumSystemVersion</key><string>15.0</string>
	<!-- "." is Contents/Resources itself. Xcode's synchronized group flattens a
	     folder of resources into it, so a `Fonts` subdirectory would exist on the
	     Makefile path and not the Xcode one. -->
	<key>ATSApplicationFontsPath</key><string>.</string>
	<key>CFBundleIconFile</key><string>TokenPacer</string>
	<key>LSUIElement</key><true/>

	<!-- Sparkle. New builds follow the latest app release's appcast asset.
	     Older builds still poll tokenpacer.com/appcast.xml, so keep publishing it.
	     The private half of SUPublicEDKey lives in the login Keychain as
	     "Private key for signing Sparkle updates" — it is not in this repo, and
	     it cannot be recovered. -->
	<key>SUFeedURL</key><string>https://github.com/heybui/token-pacer/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key><string>upjF7oD8vW9TXGxqDlR4XSQ5AQNojCkT8Xi87J0DZWc=</string>
	<key>SUEnableAutomaticChecks</key><true/>
	<key>SUAutomaticallyUpdate</key><true/>
	<!-- Both are Sparkle's, and the second is the one that matters here. An
	     update downloaded in the background is not announced: Sparkle sits on
	     it and installs it silently on quit. `SUScheduledImpatientCheckInterval`
	     is how long it waits before giving up on that and telling the user —
	     one week by default, which for an accessory app nobody ever quits is a
	     week of running an old build without knowing. A day instead.
	     Sparkle requires the impatient interval to be the larger of the two, so
	     the feed poll comes down to an hour; it is a few hundred bytes of XML
	     and discovery is not what we are rationing. -->
	<key>SUScheduledCheckInterval</key><integer>3600</integer>
	<key>SUScheduledImpatientCheckInterval</key><integer>86400</integer>
	<key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
