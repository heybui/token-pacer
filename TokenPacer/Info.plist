<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>Token Pacer</string>
	<key>CFBundleDisplayName</key><string>Token Pacer</string>
	<key>CFBundleExecutable</key><string>TokenPacer</string>
	<key>CFBundleIdentifier</key><string>com.redevify.token-pacer</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.0.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSMinimumSystemVersion</key><string>15.0</string>
	<!-- "." is Contents/Resources itself. Xcode's synchronized group flattens a
	     folder of resources into it, so a `Fonts` subdirectory would exist on the
	     Makefile path and not the Xcode one. -->
	<key>ATSApplicationFontsPath</key><string>.</string>
	<key>CFBundleIconFile</key><string>TokenPacer</string>
	<key>LSUIElement</key><true/>

	<!-- Sparkle. The feed is served from the domain, never from a repo: the
	     source is private, so nothing unauthenticated can reach its releases —
	     and a build polls the URL it shipped with for ever, so that URL has to
	     outlive wherever the disk image happens to sit.
	     The private half of SUPublicEDKey lives in the login Keychain as
	     "Private key for signing Sparkle updates" — it is not in this repo, and
	     it cannot be recovered. -->
	<key>SUFeedURL</key><string>https://tokenpacer.com/appcast.xml</string>
	<key>SUPublicEDKey</key><string>upjF7oD8vW9TXGxqDlR4XSQ5AQNojCkT8Xi87J0DZWc=</string>
	<key>SUEnableAutomaticChecks</key><true/>
	<key>SUAutomaticallyUpdate</key><true/>
	<key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
